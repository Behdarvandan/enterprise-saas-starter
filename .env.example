# Supabase project credentials — copy to `.env.local` and fill in real values.
# Find them at: https://supabase.com/dashboard/project/<ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — server-only, never expose to the client.
# Used by privileged operations such as the Stripe webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe webhook signing secret for the /api/webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price IDs for each plan (server-only)
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx
