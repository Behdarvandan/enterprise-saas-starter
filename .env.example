# Supabase project credentials — copy to `.env.local` and fill in real values.
# Find them at: https://supabase.com/dashboard/project/<ref>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — server-only, never expose to the client.
# Used by privileged operations such as the Stripe webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret for the /api/webhooks/stripe endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe price IDs for the geo-isolated SaaS plan matrix (server-only).
# Stripe prices are currency-specific — one Price object can't serve both EUR
# and USD — so Starter/Pro each need one Price per region. Enterprise has no
# priceId anywhere: it's contact-only in every region (see src/lib/plans.ts).
# TR pricing goes through PayTR instead (amount-based, no priceId needed).
STRIPE_PRICE_STARTER_EUR=price_xxx
STRIPE_PRICE_PRO_EUR=price_xxx
STRIPE_PRICE_STARTER_USD=price_xxx
STRIPE_PRICE_PRO_USD=price_xxx

# Currency for Stripe booking checkout sessions (ISO 4217, lowercase).
# Defaults to "usd" when unset. Unrelated to the SaaS plan matrix above —
# this is for tenants' own end-customers paying a booking deposit.
# STRIPE_CURRENCY=usd

# Payment provider routing for tenants' own booking-deposit checkout
# (src/app/api/checkout/booking/route.ts) — 'stripe' | 'paytr' (defaults to
# 'stripe'). Unrelated to Pasargad's own SaaS plan checkout, which resolves
# its payment provider per-region instead (see src/lib/geo.ts).
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# For local testing only: force src/lib/geo.ts's region detection instead of
# reading Vercel's x-vercel-ip-country header (which isn't present in local
# dev). Ignored in production. 'tr' | 'eu' | 'global'.
# PRICING_REGION_OVERRIDE=tr

# PayTR (Turkish local gateway) — https://www.paytr.com
# Required for Pasargad's own TR-region SaaS plan checkout, and when
# NEXT_PUBLIC_PAYMENT_PROVIDER=paytr for tenant booking checkout.
PAYTR_MERCHANT_ID=your-merchant-id
PAYTR_MERCHANT_KEY=your-merchant-key
PAYTR_MERCHANT_SALT=your-merchant-salt
# Optional PayTR overrides.
# PAYTR_TEST_MODE=1
# PAYTR_CURRENCY=TL
# PAYTR_MAX_INSTALLMENT=12
# PAYTR_NO_INSTALLMENT=0
# PAYTR_TIMEOUT_LIMIT=30
# PAYTR_DEBUG_ON=0

# Lemon Squeezy — https://app.lemonsqueezy.com/settings/api
# Used by src/modules/billing/lemonsqueezy.ts (webhook signature
# verification) and createLemonSqueezyCheckoutAction (checkout creation).
# Hand-rolled fetch/HMAC — no SDK is installed for this provider.
LEMONSQUEEZY_API_KEY=ls_xxx

# Webhook signing secret for the /api/webhooks/lemonsqueezy endpoint
# (verifyLemonSqueezySignature). Leave unset only for local testing —
# signature verification is skipped (with a warning logged) when unset.
LEMONSQUEEZY_WEBHOOK_SECRET=whsec_xxx

# Store id from https://app.lemonsqueezy.com/settings/stores — required as
# the `store` relationship on every Checkouts API request.
LEMONSQUEEZY_STORE_ID=12345

# Variant ids for the monthly/yearly subscription products
# (dashboard: Products > <product> > Variants).
LEMONSQUEEZY_VARIANT_ID_MONTHLY=123456
LEMONSQUEEZY_VARIANT_ID_YEARLY=123457

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxx
# EMAIL_FROM defaults to Resend's shared sandbox sender
# ("onboarding@resend.dev") when unset. That sandbox sender only delivers to
# the Resend account's own verified email — real customers never receive
# invite/reset/booking emails until this is set to a sender on a domain
# you've verified in Resend (Domains > Add Domain, then DNS records).
# EMAIL_FROM=Pasargad <hello@yourdomain.com>

# Where to send an internal notification email for every new lead submitted
# via /services. Leave unset to no-op (no notification sent, lead is still
# saved).
# LEADS_NOTIFICATION_EMAIL=ops@yourdomain.com

# AI / RAG — embeddings and LLM streaming.
# Document-ingest embeddings use Google's gemini-embedding-001 pinned to 1536
# dimensions (src/lib/rag/embeddings.ts). This MUST match the pasargad-core
# query engine, which embeds queries with the same model — a different model
# means a different vector space and uploaded documents won't be found.
# Get a key at https://aistudio.google.com/apikey (server-only).
GOOGLE_API_KEY=your-google-api-key
# Only used as the chat-completion fallback (src/lib/rag/llm.ts).
OPENAI_API_KEY=sk-xxx

# Pasargad API engine — the Next.js chat route proxies RAG chat to this
# backend (src/app/api/chat/rag/route.ts). Defaults to http://localhost:8000.
# REQUIRED in production: the default points at localhost, so if this is left
# unset every chat reply falls back to the generic "can't process your
# request" message. The backend has its own environment (Supabase, LLM keys,
# and the production-mandatory AGENCY_KEY_ENCRYPTION_SECRET) — see
# pasargad-core/.env.example.
# PASARGAD_API_URL=https://api.your-domain.com
# Optional: override the OpenAI chat model used as the Groq fallback.
# Defaults to "gpt-4o-mini" when unset.
# OPENAI_MODEL=gpt-4o-mini
# Preferred LLM provider for RAG chat streaming (Groq). If unset, the chat
# route falls back to OpenAI (gpt-4o-mini).
GROQ_API_KEY=gsk_xxx
# Optional: override the Groq model. Defaults to "llama-3.3-70b-versatile".
# GROQ_MODEL=llama-3.3-70b-versatile

# PostHog (product analytics) — https://posthog.com
# Leave unset to no-op locally; both client and server helpers check this.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.sentry.io/123
SENTRY_DSN=https://your-dsn.ingest.sentry.io/123
# Optional: source map upload (CI only). Leave empty to skip source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Protects the cleanup cron endpoint (/api/cron/cleanup-pending-appointments).
# Set a long, random value and pass it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=replace-with-a-long-random-secret

# Upstash Redis — used for rate limiting public API routes.
# Find these at https://console.upstash.com/redis under "REST API".
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# White-label custom domains (see src/lib/agency/cname.ts).
# Both are optional, with the defaults shown, but set them explicitly in
# production so they are visible in your environment settings.
#
# Comma-separated domains the platform itself is served from; these and their
# subdomains are never treated as an agency's custom domain. Include every
# hostname you serve the product on (apex, www, app, ...). Defaults to
# "localhost,pasargad.app" when unset (*.localhost and *.vercel.app are always
# platform hosts).
# PLATFORM_DOMAINS=localhost,pasargad.app
#
# The hostname agencies point their CNAME record at. It must be a real
# hostname that resolves to this deployment (e.g. a DNS-only record to your
# host), and agencies must set their record to DNS-only (not proxied) or the
# CNAME can't be verified. Defaults to "cname.pasargad.app".
# CNAME_TARGET=cname.pasargad.app

# SSO/SAML — architectural readiness only (see src/lib/sso/adapter.ts and
# the sso_connections table). No SAML library is installed and no callback
# route exists yet, so these are placeholders for a future implementation,
# not read by any code today.
# SAML_OKTA_CLIENT_ID=
# SAML_OKTA_CLIENT_SECRET=
# SAML_OKTA_ISSUER=
# SAML_GOOGLE_CLIENT_ID=
# SAML_GOOGLE_CLIENT_SECRET=
# SAML_GOOGLE_ISSUER=
